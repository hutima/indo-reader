{
  "name": "indo-reader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Indonesian Bible reader with English glosses, root-family notes, and learner vocabulary support.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "import:ags": "node scripts/import-ags.mjs",
    "sync:pbwl": "node scripts/sync-pbwl.mjs",
    "prepare:data": "npm run import:ags && npm run import:bsb && npm run sync:pbwl && npm run coverage && npm run build:context-glosses",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "coverage": "node scripts/coverage.mjs",
    "verify:pwa": "node scripts/verify-pwa.mjs",
    "verify:lexicon": "node scripts/verify-lexicon.mjs",
    "import:bsb": "node scripts/import-bsb.mjs",
    "build:context-glosses": "node scripts/build-context-glosses.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "fflate": "^0.8.2",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "vite-plugin-pwa": "^0.20.5",
    "workbox-precaching": "^7.1.0"
  }
}
